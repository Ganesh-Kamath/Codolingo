# Codolingo Environment Configuration Example
# By default, Codolingo is a 100% client-side application running offline with WebAssembly (Pyodide) and localStorage.
# All environment variables are optional.

# Optional: Supabase credentials (if connecting to remote cloud sync in future)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-Side Curriculum Authoring (PRIVATE - NEVER prefix with VITE_)
# Strictly server-side only for offline content authoring and explanation generation
OPENAI_API_KEY=YOUR_NEW_ROTATED_API_KEY_HERE
OPENAI_MODEL=gpt-4o-mini
